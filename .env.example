# =============================================================================
# AgenticTrader — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# CoinDCX API (https://coindcx.com/api-dashboard)
COINDCX_API_KEY=your_coindcx_api_key_here
COINDCX_API_SECRET=your_coindcx_api_secret_here

# LLM Provider: 'openrouter' (default), 'gemini', or 'none' (disable all LLM)
LLM_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys — free tier available)
# NOTE: Free model IDs rotate. Check https://openrouter.ai/models for current list.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Candidate models tried in order (comma-separated). Last resort is openrouter/auto.
LLM_CANDIDATE_MODELS=meta-llama/llama-4-maverick:free,google/gemini-2.0-flash-exp:free,openrouter/auto

# Legacy Gemini (kept for rollback — only used if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Per-Agent LLM Toggles (set to false to use deterministic fallback for that agent)
USE_LLM_TECHNICAL=true
USE_LLM_SENTIMENT=true
USE_LLM_RISK_EXPLANATION=true
USE_LLM_ORCHESTRATOR=true

# News: Yahoo Finance (no API key needed — free!)

# Trading Configuration
PAPER_TRADING=true
TRADING_PAIRS=BTCINR,USDTINR
INITIAL_CAPITAL_INR=100000
TRADING_INTERVAL_MINUTES=15

# Risk Management
MAX_POSITION_SIZE_PCT=10
MAX_DRAWDOWN_PCT=8
MAX_TRADES_PER_DAY=10

# Dashboard
STREAMLIT_PORT=8501
